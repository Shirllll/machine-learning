+def train_decision_tree(dataset: pd.DataFrame) -> TrainingResult:
+    """Train a decision tree on the dataset and return evaluation metrics."""
+    features = dataset.drop(columns=["buys_computer"])
+    target = dataset["buys_computer"]
+
+    categorical_columns = features.columns.tolist()
+    preprocessor = ColumnTransformer(
+        [("categorical", OneHotEncoder(handle_unknown="ignore"), categorical_columns)]
+    )
+
+    classifier = DecisionTreeClassifier(random_state=42)
+    model = Pipeline([("preprocess", preprocessor), ("classifier", classifier)])
+
+    x_train, x_test, y_train, y_test = train_test_split(
+        features, target, test_size=0.3, random_state=42, stratify=target
+    )
+    model.fit(x_train, y_train)
+
+    predictions = model.predict(x_test)
+    accuracy = accuracy_score(y_test, predictions)
+    report = classification_report(y_test, predictions)
+    return TrainingResult(model=model, accuracy=accuracy, report=report)
+
+
+def print_tree(model: Pipeline, feature_names: list[str]) -> None:
+    """Print a text representation of the fitted decision tree."""
+    encoder = model.named_steps["preprocess"].named_transformers_["categorical"]
+    encoded_features = encoder.get_feature_names_out(feature_names)
+    tree = model.named_steps["classifier"]
+    print(export_text(tree, feature_names=list(encoded_features)))
+
+
+def main() -> None:
